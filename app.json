{
  "expo": {
    "name": "SuisseAI",
    "slug": "suisseai-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "suisseaiapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.suisseai.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "SuisseAI benötigt Kamerazugriff, um Fotos für die Bildanalyse aufzunehmen.",
        "NSPhotoLibraryUsageDescription": "SuisseAI benötigt Zugriff auf deine Fotos, um Bilder zur Analyse auszuwählen."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.suisseai.app"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "SuisseAI benötigt Zugriff auf deine Fotos, um Bilder zur Analyse auszuwählen.",
          "cameraPermission": "SuisseAI benötigt Kamerazugriff, um Fotos für die Bildanalyse aufzunehmen."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f6c3b8e3-1ad9-4b08-b0a7-98c76fc99a5b"
      }
    }
  }
}
